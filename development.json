{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "Shared base settings for repositories under active development",
  "extends": [
    "github>mono0x/renovate-config:base"
  ],
  "packageRules": [
    {
      "matchUpdateTypes": [
        "minor",
        "patch",
        "digest",
        "pin",
        "pinDigest"
      ],
      "schedule": [
        "* * * * 1"
      ]
    },
    {
      "matchJsonata": [
        "groupName = 'GitHub Actions'"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch",
        "digest",
        "pin",
        "pinDigest"
      ],
      "schedule": [
        "* * 1 * *"
      ]
    }
  ]
}
