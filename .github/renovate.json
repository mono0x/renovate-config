{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "github>mono0x/renovate-config:hk-pkl",
    "github>mono0x/renovate-config:dprint-plugins"
  ],
  "timezone": "Asia/Tokyo",
  "minimumReleaseAge": "2 days",
  "schedule": [
    "* * 1 * *"
  ],
  "packageRules": [
    {
      "matchManagers": [
        "github-actions"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "groupName": "GitHub Actions"
    },
    {
      "matchManagers": [
        "mise"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "groupName": "mise tools"
    },
    {
      "matchDepNames": [
        "hk-pkl"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "groupName": "mise tools"
    }
  ]
}
